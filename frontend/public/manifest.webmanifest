{
  "name": "rolltop",
  "short_name": "rolltop",
  "description": "Self-hosted email mirror, search, and compose",
  "start_url": "/mail/relevant",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6f8fc",
  "theme_color": "#f6f8fc",
  "icons": [
    {
      "src": "/icons/mail.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/mail-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/mail-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/mail-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/mail-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Mail",
      "url": "/mail/relevant",
      "icons": [
        {
          "src": "/icons/mail.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Calendar",
      "url": "/calendar",
      "icons": [
        {
          "src": "/icons/calendar.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Contacts",
      "url": "/contacts",
      "icons": [
        {
          "src": "/icons/contacts.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ]
}
