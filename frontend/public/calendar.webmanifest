{
  "id": "/calendar",
  "name": "rolltop Calendar",
  "short_name": "Calendar",
  "description": "The rolltop calendar in a window of its own",
  "start_url": "/calendar",
  "scope": "/calendar",
  "display": "standalone",
  "background_color": "#f6f8fc",
  "theme_color": "#f6f8fc",
  "icons": [
    {
      "src": "/icons/calendar.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/calendar-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/calendar-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/calendar-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/calendar-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Mail",
      "url": "/mail/relevant",
      "icons": [
        {
          "src": "/icons/mail.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    },
    {
      "name": "Contacts",
      "url": "/contacts",
      "icons": [
        {
          "src": "/icons/contacts.svg",
          "sizes": "any",
          "type": "image/svg+xml"
        }
      ]
    }
  ]
}
