{
  "name": "rolltop",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc -b --pretty false",
    "build": "npm run typecheck && vite build && npm run build:plugins",
    "build:themes": "mkdir -p plugins/matrix_theme/frontend_dist/themes/matrix && sass plugins/matrix_theme/themes/matrix/theme.scss plugins/matrix_theme/frontend_dist/themes/matrix/theme.css --style=compressed",
    "build:plugins": "node scripts/build-plugins.mjs",
    "build:pgp-css": "mkdir -p plugins/client_side_pgp/frontend_dist/styles && sass plugins/client_side_pgp/frontend/styles/pgp.scss plugins/client_side_pgp/frontend_dist/styles/pgp.css --style=compressed",
    "build:mail-filters-css": "mkdir -p plugins/mail_filters/frontend_dist && sass plugins/mail_filters/frontend/styles.css plugins/mail_filters/frontend_dist/styles.css --style=compressed",
    "build:remote-imap-sync-css": "mkdir -p plugins/remote_imap_sync/frontend_dist && sass plugins/remote_imap_sync/frontend/styles.css plugins/remote_imap_sync/frontend_dist/styles.css --style=compressed",
    "build:experimental-spam-filter-css": "mkdir -p plugins/experimental_spam_filter/frontend_dist && sass plugins/experimental_spam_filter/frontend/styles.css plugins/experimental_spam_filter/frontend_dist/styles.css --style=compressed",
    "build:vite": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "android:build": "./android/gradlew -p android :app:assembleDebug"
  },
  "dependencies": {
    "@embedpdf/pdfium": "^2.14.3",
    "@embedpdf/react-pdf-viewer": "^2.14.3",
    "@fontsource/fraunces": "^5.2.9",
    "@phosphor-icons/react": "^2.1.10",
    "@vitejs/plugin-react": "^4.3.4",
    "dompurify": "^3.4.7",
    "openpgp": "^6.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11"
  },
  "devDependencies": {
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "sass": "^1.69.5"
  }
}
